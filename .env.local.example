# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings -> API, and Project Settings -> Database).
# .env.local is gitignored and must never be committed.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never exposed to the browser. Bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# Used by `supabase db push` / `supabase migration` CLI commands.
SUPABASE_DB_URL=
